{
  "name": "deepseek-chat",
  "version": "0.2.0",
  "description": "DeepSeek chat desktop app with a Python tool, based on deepseek-ai/chat-demo.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rm -rf dist && NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src spine slices libs scripts/check-dag.mjs rspack.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --import ./scripts/test-loader.mjs --test \"src/**/*.test.ts\" \"spine/tests/**/*.test.ts\" \"slices/*/tests/**/*.test.ts\" \"libs/*/tests/**/*.test.ts\"",
    "test:spine": "node --import ./scripts/test-loader.mjs --test \"spine/tests/**/*.test.ts\" \"slices/*/tests/**/*.test.ts\" \"libs/*/tests/**/*.test.ts\"",
    "check:dag": "node scripts/check-dag.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "pyodide:fetch": "node scripts/fetch-pyodide.mjs",
    "dev:desktop": "pnpm dev",
    "build:desktop": "pnpm build"
  },
  "dependencies": {
    "@deepseek-chat/lib-markdown": "workspace:*",
    "@deepseek-chat/slice-account": "workspace:*",
    "@deepseek-chat/slice-browser": "workspace:*",
    "@deepseek-chat/slice-preferences": "workspace:*",
    "@deepseek-chat/slice-python": "workspace:*",
    "@deepseek-chat/slice-voice": "workspace:*",
    "@deepseek-chat/slice-web-research": "workspace:*",
    "@deepseek-chat/slice-workspace-files": "workspace:*",
    "@deepseek-chat/spine": "workspace:*",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "pyodide": "314.0.8",
    "typescript": "7.0.2"
  }
}
