{
  "name": "deepseek-chat",
  "version": "0.2.0",
  "description": "DeepSeek chat desktop app with a Python tool, based on deepseek-ai/chat-demo.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "dev:workbench": "rspack serve -c rspack.config.ts --open /?workbench=1",
    "dev:ssa": "rspack serve -c rspack.config.ts --open '/?workbench=1&tab=ssa'",
    "build": "rm -rf dist && NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -b",
    "lint": "oxlint app spine test-support slices libs scripts/check-dag.mjs scripts/check-design.mjs scripts/check-ipc.mjs rspack.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --import ./scripts/test-loader.mjs --test \"app/tests/**/*.test.ts\" \"spine/tests/**/*.test.ts\" \"test-support/tests/**/*.test.ts\" \"slices/*/tests/**/*.test.ts\" \"libs/*/tests/**/*.test.ts\"",
    "test:spine": "node --import ./scripts/test-loader.mjs --test \"spine/tests/**/*.test.ts\" \"test-support/tests/**/*.test.ts\" \"slices/*/tests/**/*.test.ts\" \"libs/*/tests/**/*.test.ts\"",
    "check:dag": "node scripts/check-dag.mjs",
    "check:ipc": "node scripts/check-ipc.mjs",
    "check:design": "node scripts/check-design.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "pyodide:fetch": "node scripts/fetch-pyodide.mjs",
    "dev:desktop": "pnpm dev",
    "build:desktop": "pnpm build"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "~20.9.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "pyodide": "314.0.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2"
  }
}
