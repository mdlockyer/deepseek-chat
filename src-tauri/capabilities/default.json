{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: core APIs, HTTP requests to the DeepSeek and Firecrawl APIs only, and opening http(s)/mailto/tel links in the default browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.deepseek.com/*"
        },
        {
          "url": "https://api.firecrawl.dev/*"
        }
      ],
      "deny": []
    },
    "opener:allow-default-urls",
    "opener:allow-open-url"
  ]
}
